# Copia este archivo como .env y ajusta los valores. Nunca subas .env al repositorio.
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Ruta de la base de datos (SQLite). Relativa a la raíz del proyecto si se deja vacía.
DATABASE_PATH=

# Orígenes permitidos (separados por coma, sin barra final).
# Nombre canónico: ALLOWED_ORIGINS. CORS_ORIGINS se acepta como alias.
ALLOWED_ORIGINS=http://localhost:8099,http://127.0.0.1:8099
# CORS_ORIGINS=http://localhost:8099,http://127.0.0.1:8099

# Actívalo en producción cuando el TLS lo termine un proxy inverso (nginx, Caddy,
# Cloudflare…): añade la cabecera Strict-Transport-Security a las respuestas.
FORCE_HTTPS=false

# Sirve también el frontend desde FastAPI
SERVE_FRONTEND=true
